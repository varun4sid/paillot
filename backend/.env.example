# Copy to backend/.env and fill in. Never commit .env.

# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" string (port 5432) — it works over IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Any long random string, e.g. output of:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

JWT_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins, or * for any (fine for the demo:
# auth uses Bearer tokens, not cookies).
CORS_ORIGINS=*
